# Copy to .env.local (or .env) and fill in values as needed.

# Public site URL (used for absolute links if needed)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp business number — digits only, country code included (no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase — wire these when you connect the project
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
