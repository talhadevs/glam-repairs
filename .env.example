# Copy to .env and fill in real values. Do not commit .env.

# Public site URL (used for absolute links if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp business number — digits only, country code included (no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Server only — never expose in the browser (lead insert + photo upload)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public Storage bucket for assessment photos (create in Supabase → Storage)
SUPABASE_PHOTOS_BUCKET=assessment-photos

# Protects /api/cron/cleanup-photos (photos auto-delete after 30 days; lead data stays)
CRON_SECRET=a-long-random-string
